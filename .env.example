# Copie para .env e preencha. NUNCA versione o .env.
POSTGRES_USER=atlas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=atlas
ATLAS_LOG_LEVEL=INFO
# Desenvolvimento sem Docker (SQLite): deixe ATLAS_DATABASE_URL vazio.
# ATLAS_DATABASE_URL=postgresql+psycopg2://atlas:senha@localhost:5432/atlas

# Credenciais de provedor (somente backend; nunca expostas no frontend).
# A integração Cedro está PENDENTE de documentação oficial — preencher não habilita conexão.
# ATLAS_CEDRO_USERNAME=
# ATLAS_CEDRO_PASSWORD=
# ATLAS_CEDRO_ENDPOINT=
